# Copy to .env on the server and fill in:  cp .env.template .env

# --- Required -----------------------------------------------------------------

# Public URL the app is served from (scheme + host, no trailing slash).
# adapter-node uses it to build request URLs and to block cross-site form posts.
ORIGIN=https://example.com

# Host port the app is published on. The app always listens on 3000 inside the container.
PORT=3000

# --- Reverse proxy (optional) -------------------------------------------------

# Only used when ORIGIN is empty: read protocol/host from proxy headers instead.
PROTOCOL_HEADER=
HOST_HEADER=

# Header carrying the real client IP (e.g. X-Forwarded-For). Leave empty if unused.
ADDRESS_HEADER=
# Number of trusted proxies in front of the app (used with X-Forwarded-For).
XFF_DEPTH=1

# --- Server tuning (optional) -------------------------------------------------

# Max request body size (e.g. 512K, 1M, Infinity).
BODY_SIZE_LIMIT=512K
# Seconds to wait for in-flight requests on shutdown before forcing exit.
SHUTDOWN_TIMEOUT=30
